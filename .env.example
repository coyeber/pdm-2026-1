# Copie este arquivo para .env e preencha com as credenciais da SUA aplicação Back4App.
# Dashboard > App Settings > Security & Keys
EXPO_PUBLIC_BACK4APP_APP_ID=COLOQUE_SEU_APPLICATION_ID
EXPO_PUBLIC_BACK4APP_CLIENT_KEY=COLOQUE_SUA_CLIENT_KEY
# URL padrão; troque somente se sua aplicação utiliza um subdomínio próprio.
EXPO_PUBLIC_BACK4APP_SERVER_URL=https://parseapi.back4app.com
